{
  "name": "@sandsoftwaresolutions/money-cents",
  "version": "0.1.1",
  "description": "Money as whole cents: read Dutch and English notation, format, split without losing a cent, VAT both ways, explicit rounding.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "money",
    "cents",
    "vat",
    "btw",
    "currency",
    "rounding"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-money-cents.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-money-cents/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-money-cents#readme",
  "publishConfig": {
    "access": "public"
  }
}
